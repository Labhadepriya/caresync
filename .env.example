# CareSync shared configuration template
# These are placeholders, not real credentials.
# Frontend and backend configuration will be defined separately
# when their applications are initialized.

# Backend
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=caresync
DB_USER=caresync_user
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=localhost
DB_PORT=5432

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
